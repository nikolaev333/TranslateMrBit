# Application
APP_ENV=production
APP_PORT=8000
APP_HOST=0.0.0.0
APP_PASSWORD=CHANGE_ME
SESSION_SECRET=CHANGE_ME_TO_LONG_RANDOM_SECRET
# Set to true behind Coolify / Traefik / Nginx HTTPS reverse proxy
SESSION_HTTPS_ONLY=true
SESSION_COOKIE_NAME=whisper_session
SESSION_MAX_AGE_HOURS=168

# Whisper defaults (match local CLI: --model large --language Bulgarian --task transcribe)
WHISPER_MODEL=large
WHISPER_LANGUAGE=Bulgarian
# Use cpu on OVH without GPU so /health never needs to probe CUDA via torch.
# Override to cuda only on GPU hosts with the NVIDIA toolkit installed.
WHISPER_DEVICE=cpu
WHISPER_MODEL_DIR=/models
# Optional: force fp16 on/off. Leave empty for auto (GPU=on, CPU=off)
WHISPER_FP16=

# Storage paths inside the container
DATA_DIR=/data
UPLOAD_DIR=/data/uploads
OUTPUT_DIR=/data/outputs
DB_PATH=/data/db/whisper.db

# Limits and cleanup
MAX_UPLOAD_MB=500
MAX_CONCURRENT_JOBS=1
AUTO_DELETE_UPLOADS_DAYS=7
# Allowed extensions (comma-separated)
ALLOWED_EXTENSIONS=mp3,wav,m4a,mp4,flac,ogg,webm,aac,wma,mkv,mov,opus

# Auth rate limiting
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60

# Worker
WORKER_POLL_INTERVAL_SECONDS=1.0
# Production compose runs a separate whisper-worker container (keep false)
RUN_EMBEDDED_WORKER=false
UNLOAD_MODEL_AFTER_JOB=true

# Inference backend (openai-whisper default; faster-whisper optional: pip install faster-whisper)
INFERENCE_BACKEND=openai-whisper

# MrBit Smart Vocabulary
VOCABULARY_PROMPT_MAX_CHARS=800
VOCABULARY_AUTO_ANALYZE=true
VOCABULARY_SEED_DEFAULTS=true

# MrBit Quality Analyzer
QUALITY_AUTO_ANALYZE=false
QUALITY_INCLUDE_AUDIO=true
QUALITY_MAX_AUDIO_ANALYZE_SECONDS=600

# MrBit Smart Processing Engine
SMART_PROCESSING_ENABLED=true
PROCESSING_SAFETY_MARGIN_GB=0.75
PROCESSING_ENFORCE_MEMORY_GATE=true
PROCESSING_ALLOW_UNSAFE_MODELS=false
PROCESSING_ENABLE_CHUNKING=false
PROCESSING_CHUNK_SECONDS=600
PROCESSING_CHUNK_OVERLAP_SECONDS=1
PROCESSING_MAX_RETRIES=2
PROCESSING_JOB_TIMEOUT_SECONDS=0
PROCESSING_LEASE_SECONDS=1800
JOB_SUBMIT_RATE_LIMIT=30
JOB_SUBMIT_RATE_WINDOW_SECONDS=60
# WORKER_ID=  # optional stable worker id; auto-generated if empty
